{
  "name": "theprivator-desktop",
  "version": "3.2.0",
  "private": true,
  "description": "ThePrivator Tauri 2 desktop rewrite spine.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "verify": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1",
    "format": "pwsh -NoLogo -NoProfile -File scripts/format.ps1",
    "format:check": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only format",
    "lint": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only lint",
    "stylelint": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only stylelint",
    "typecheck": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only typecheck",
    "deadcode": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only deadcode",
    "dupes": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only dupes",
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "test": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -Only test",
    "tauri": "tauri",
    "verify:release": "node scripts/verify-release.mjs",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "verify:sidecar": "node scripts/verify-sidecar.mjs",
    "verify:m004:s01": "node scripts/verify-m004-s01.mjs",
    "verify:m004:s02": "node scripts/verify-m004-s02.mjs",
    "verify:m004:s03": "node scripts/verify-m004-s03.mjs",
    "verify:m004:s04": "node scripts/verify-m004-s04.mjs",
    "verify:m004:s05": "node scripts/verify-m004-s05.mjs",
    "verify:m005:s01": "node scripts/verify-m005-s01.mjs",
    "verify:m005:s02": "node scripts/verify-m005-s02.mjs",
    "verify:m005:s03": "node scripts/verify-m005-s03.mjs",
    "verify:m005:s04": "node scripts/verify-m005-s04.mjs",
    "verify:s01": "node scripts/verify-s01.mjs",
    "verify:s01:packaged": "node scripts/verify-s01.mjs --package-artifacts-only",
    "verify:s02": "node scripts/verify-s02.mjs",
    "verify:s03": "node scripts/verify-s03.mjs",
    "verify:s04": "node scripts/verify-s04.mjs",
    "verify:s05": "node scripts/verify-s05.mjs",
    "verify:s06": "node scripts/verify-s06.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "3.0.0-alpha.3",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tauri-apps/cli": "3.0.0-alpha.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^27.0.0",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "playwright-core": "^1.60.0",
    "selenium-webdriver": "^4.43.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,yml,yaml}": "pwsh -NoLogo -NoProfile -File scripts/hooks/lint-staged.ps1"
  },
  "engines": {
    "node": "^22.18 || ^24.11 || >=26"
  },
  "productName": "ThePrivator"
}
